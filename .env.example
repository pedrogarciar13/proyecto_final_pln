# Copie este archivo como .env (o defina las variables en su terminal). No contiene secretos.
# Ruta de la base completa; si no existe, el notebook usa data/muestra_melisa_estratificada.csv
DATA_PATH=data/data_melisa_comentarios.csv
# Fracción de la base a usar (1.0 = completa; 0.05 para una corrida rápida)
FRACCION=1.0
# Épocas máximas de RNN/LSTM/GRU (con early stopping)
MAX_EPOCAS_RNN=10
# Transformer de la sesión 4
BERT_CHECKPOINT=dccuchile/bert-base-spanish-wwm-cased
N_TRAIN_BERT=16000
EPOCAS_BERT=2
# Tamaño de la validación y prueba comunes para comparar todos los modelos
N_COMUN=5000
# Supuesto de costo de cómputo (US$ por hora de una instancia de 4 vCPU)
COSTO_HORA_USD=0.20
# Opcional: token de Hugging Face para descargas más rápidas (no es obligatorio; nunca lo suba al repositorio)
HF_TOKEN=
